generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  phone          String?   @unique
  email          String?   @unique
  googleId       String?   @unique
  name           String
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  isBanned       Boolean   @default(false)
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile         UserProfile?
  wallet          Wallet?
  sessions        UserSession[]
  devices         Device[]
  callsAsUser     Call[]          @relation("CallerCalls")
  favorites       Favorite[]      @relation("UserFavorites")
  blocksGiven     Block[]         @relation("BlockerBlocks")
  blocksReceived  Block[]         @relation("BlockedUserBlocks")
  reportsGiven    Report[]        @relation("ReporterReports")
  reportsReceived Report[]        @relation("ReportedUserReports")
  payments        Payment[]
  notifications   Notification[]
  tickets         SupportTicket[]
  listener        Listener?
  interests       UserInterest[]
  ratingsGiven    CallRating[]
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime
  gender      Gender
  city        String?
  bio         String?
  photoUrl    String?
  language    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Device {
  id         String    @id @default(uuid())
  userId     String?
  listenerId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listener   Listener? @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  fcmToken   String    @unique
  platform   Platform
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Listener {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ListenerStatus @default(PENDING)
  onlineStatus    OnlineStatus   @default(OFFLINE)
  isAudioEnabled  Boolean        @default(true)
  isVideoEnabled  Boolean        @default(false)
  rejectionReason String?
  adminNotes      String?
  approvedAt      DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile          ListenerProfile?
  documents        ListenerDocument[]
  availability     ListenerAvailability[]
  callsAsListener  Call[]           @relation("ListenerCalls")
  earnings         Earning[]
  payouts          Payout[]
  favorites        Favorite[]       @relation("ListenerFavorites")
  blocksReceived   Block[]          @relation("ListenerBlocks")
  reportsReceived  Report[]         @relation("ListenerReports")
  interests        ListenerInterest[]
  wallet           ListenerWallet?
  device           Device[]
  ratingsReceived  CallRating[]
}

model ListenerProfile {
  id                 String   @id @default(uuid())
  listenerId         String   @unique
  listener           Listener @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  displayName        String
  dateOfBirth        DateTime
  city               String?
  state              String?
  relationshipStatus String?
  bio                String?
  photoUrl           String?
  galleryUrls        String[] @default([])
  languages          String[] @default([])
  rating             Float    @default(0)
  totalRatings       Int      @default(0)
  totalCalls         Int      @default(0)
  totalMinutes       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ListenerDocument {
  id         String         @id @default(uuid())
  listenerId String
  listener   Listener       @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ListenerAvailability {
  id         String   @id @default(uuid())
  listenerId String
  listener   Listener @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Call {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation("CallerCalls", fields: [userId], references: [id])
  listenerId     String
  listener       Listener   @relation("ListenerCalls", fields: [listenerId], references: [id])
  type           CallType
  status         CallStatus @default(INITIATED)
  agoraChannelId String?    @unique
  userUid        Int?
  listenerUid    Int?
  ringExpiresAt  DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  durationSeconds Int?
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  billing  CallBilling?
  earning  Earning?
  rating   CallRating?
}

model CallBilling {
  id            String   @id @default(uuid())
  callId        String   @unique
  call          Call     @relation(fields: [callId], references: [id])
  ratePerMinute Int
  coinsDeducted Decimal  @db.Decimal(10, 4)
  isProcessed   Boolean  @default(false)
  processedAt   DateTime?
  createdAt     DateTime @default(now())
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal  @default(0) @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

model ListenerWallet {
  id               String   @id @default(uuid())
  listenerId       String   @unique
  listener         Listener @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0) @db.Decimal(10, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(10, 2)
  totalEarned      Decimal  @default(0) @db.Decimal(10, 2)
  totalWithdrawn   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WalletTransaction {
  id            String       @id @default(uuid())
  walletId      String
  wallet        Wallet       @relation(fields: [walletId], references: [id])
  type          WalletTxType
  amount        Decimal      @db.Decimal(10, 4)
  balanceBefore Decimal      @db.Decimal(10, 4)
  balanceAfter  Decimal      @db.Decimal(10, 4)
  description   String?
  refId         String?
  metadata      Json?
  createdAt     DateTime     @default(now())
}

model CoinPackage {
  id               String   @id @default(uuid())
  name             String
  coins            Int
  bonusCoins       Int      @default(0)
  priceInr         Decimal  @db.Decimal(10, 2)
  originalPriceInr Decimal? @db.Decimal(10, 2)
  badge            String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments Payment[]
}


model Payment {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  coinPackageId     String?
  coinPackage       CoinPackage?  @relation(fields: [coinPackageId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  coins             Int
  bonusCoins        Int           @default(0)
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Earning {
  id             String        @id @default(uuid())
  listenerId     String
  listener       Listener      @relation(fields: [listenerId], references: [id])
  callId         String        @unique
  call           Call          @relation(fields: [callId], references: [id])
  grossCoins     Decimal       @db.Decimal(10, 4)
  commissionRate Decimal       @db.Decimal(5, 2)
  platformCut    Decimal       @db.Decimal(10, 4)
  listenerAmount Decimal       @db.Decimal(10, 2)
  coinToInrRate  Decimal       @db.Decimal(10, 4)
  status         EarningStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Payout {
  id             String       @id @default(uuid())
  listenerId     String
  listener       Listener     @relation(fields: [listenerId], references: [id])
  amount         Decimal      @db.Decimal(10, 2)
  status         PayoutStatus @default(REQUESTED)
  payoutMethod   String?
  accountDetails Json?
  adminId        String?
  adminNotes     String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions PayoutTransaction[]
}

model PayoutTransaction {
  id        String       @id @default(uuid())
  payoutId  String
  payout    Payout       @relation(fields: [payoutId], references: [id])
  status    PayoutStatus
  notes     String?
  createdAt DateTime     @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  listenerId String
  listener   Listener @relation("ListenerFavorites", fields: [listenerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, listenerId])
}

model Block {
  id                String    @id @default(uuid())
  blockerId         String
  blocker           User      @relation("BlockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId     String?
  blockedUser       User?     @relation("BlockedUserBlocks", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blockedListenerId String?
  blockedListener   Listener? @relation("ListenerBlocks", fields: [blockedListenerId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
}

model Report {
  id                 String         @id @default(uuid())
  reporterId         String
  reporter           User           @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedUserId     String?
  reportedUser       User?          @relation("ReportedUserReports", fields: [reportedUserId], references: [id])
  reportedListenerId String?
  reportedListener   Listener?      @relation("ListenerReports", fields: [reportedListenerId], references: [id])
  category           ReportCategory
  description        String?
  status             ReportStatus   @default(OPEN)
  adminId            String?
  adminNotes         String?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listenerId String?
  type       NotificationType
  title      String
  body       String
  data       Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
}

model SupportTicket {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus  @default(OPEN)
  adminId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  replies TicketReply[]
}

model TicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model AdminUser {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String
  role        AdminRole @default(STAFF)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs AdminLog[]
}

model AdminLog {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())
}

model CallRating {
  id         String   @id @default(uuid())
  callId     String   @unique
  call       Call     @relation(fields: [callId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  listenerId String
  listener   Listener @relation(fields: [listenerId], references: [id])
  rating     Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())
}

model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  group       String      @default("general")
  description String?
  updatedAt   DateTime    @updatedAt
}

model Language {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)
}

model Interest {
  id   String @id @default(uuid())
  name String @unique
  icon String?

  userInterests     UserInterest[]
  listenerInterests ListenerInterest[]
}

model UserInterest {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model ListenerInterest {
  listenerId String
  listener   Listener @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([listenerId, interestId])
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Platform {
  ANDROID
  IOS
}

enum ListenerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OnlineStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  MISSED
  REJECTED
  CANCELLED
  FAILED
}

enum WalletTxType {
  RECHARGE
  CALL_DEDUCTION
  REFUND
  BONUS
  PROMOTIONAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum ReportCategory {
  FAKE_PROFILE
  HARASSMENT
  ABUSE
  INAPPROPRIATE
  SPAM
  SCAM
  SEXUAL_MISCONDUCT
  OTHER
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum NotificationType {
  LISTENER_ONLINE
  FAVORITE_ONLINE
  CALL_INCOMING
  CALL_ACCEPTED
  CALL_MISSED
  LOW_BALANCE
  RECHARGE_SUCCESS
  PAYOUT_STATUS
  LISTENER_APPROVED
  LISTENER_REJECTED
  SYSTEM
  PROMOTIONAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentType {
  AADHAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  SELFIE
  VOICE_SAMPLE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
